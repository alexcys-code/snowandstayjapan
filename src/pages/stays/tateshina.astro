---
import Layout from '../../layouts/Layout.astro';
import Pillow from '../../components/Pillow.astro';
import { INSTAGRAM } from '../../data/copy';
const base = import.meta.env.BASE_URL;

const features = [
  { img: 'window-view.jpg', t: 'tsMorningTitle', tf: 'Wake up inside the snow.', b: 'tsMorningBody',
    bf: 'No rushing downstairs before breakfast service ends. Make coffee in your pyjamas and have the Yatsugatake snowfield to yourselves.',
    alt: 'Snowy peaks seen through the window of the kominka' },
  { img: 'bedroom.jpg', t: 'tsHeritageTitle', tf: 'A 150-year-old soul, with modern warmth.', b: 'tsHeritageBody',
    bf: 'You sleep under century-old beams on traditional tatami — and behind them sit a modern heating system and a proper bathroom.',
    alt: 'A bedroom under century-old timber beams' },
  { img: 'narai.webp', t: 'tsBaseTitle', tf: 'Snow on the way out, home on the way back.', b: 'tsBaseBody',
    bf: 'Twenty-five minutes by car from Chino station. Ski, soak at Lake Suwa, walk the old post town — then come back to somewhere that is yours.',
    alt: 'The old post town at Narai-juku under snow' },
];

const faqs = [
  { q: 'tsQ1', qf: 'Isn’t an old house freezing?', a: 'tsA1',
    af: 'It was, before we insulated it. The whole building has been upgraded for a Nagano winter.' },
  { q: 'tsQ2', qf: 'How do we get there with all the ski luggage?', a: 'tsA2',
    af: 'You do not carry it anywhere. We meet you on the platform at Chino and drive you and the bags to the front door.' },
  { q: 'tsQ3', qf: 'There’s no hotel restaurant. What about dinner?', a: 'tsA3',
    af: 'The kitchen is fully equipped and the supermarket is on the way home from the slopes.' },
];

const legs = [
  { n: 'g1n', nf: 'Shinjuku, Tokyo', b: 'g1b', bf: 'Hop on the Azusa express. No changes, about 2 hours.' },
  { n: 'g2n', nf: 'Chino station', b: 'g2b', bf: 'Your nearest station. We meet you here and drive you the last 25 minutes to the door.' },
  { n: 'g3n', nf: 'The house · all week', b: 'g3b', bf: 'Ski days, onsen days, and dinner back at the house.' },
  { n: 'g4n', nf: 'Back to Tokyo', b: 'g4b', bf: 'We drive you to the station. Same easy train, about 2 hours.' },
];

const days = [
  { d: 'Day 1', k: 'd23', f: 'Train from Tokyo up to Nagano. Settled in before dark.' },
  { d: 'Day 2', k: 'd24', f: 'First ski lesson. Everyone else takes the cable car up for the view.' },
  { d: 'Day 3', k: 'd25', f: 'A day at Lake Suwa — a walk and a hot spring. Dinner back at the house.' },
  { d: 'Day 4', k: 'd26', f: 'Back on snow — and suddenly the kids are linking turns.' },
  { d: 'Day 5', k: 'd27', f: 'The old post town in the snow. Bring a camera.' },
  { d: 'Day 6', k: 'd28', f: 'Last ski lesson, then something hot on the summit terrace.' },
  { d: 'Day 7', k: 'd29', f: 'Back to Tokyo, in time for lunch.' },
];
---

<Layout active="stay" title="Kominka Kozumi">
  <section class="hero" data-enter="aperture">
    <div class="hero__frame frame">
      <img class="shot" src={`${base}img/house-exterior.jpg`} alt="" fetchpriority="high" />
      <div class="scrim"></div>
      <div class="hero__copy">
        <p class="eyebrow" data-i18n="tsHeroEyebrow">Kominka Kozumi · Chino, Nagano</p>
        <h1 class="hero__title" data-i18n="tsHeroTitle">150 years of history. Nobody else in it.</h1>
        <p class="hero__sub" data-i18n="tsHeroSub">
          Timber beams, tatami, and absolute privacy. A fully restored century-old farmhouse in Chino, Nagano — open to your group of two to six alone.
        </p>
      </div>
    </div>
  </section>

  <Pillow key="restOne" fallback="Snow out the front door." tone="ground" align="end" mark="br" />

  <section class="section paper feats">
    <p class="eyebrow" data-i18n="tsFeatEyebrow">What a whole house gives you</p>
    <div class="feats__list" data-enter="recede">
      {features.map((f, i) => (
        <article class:list={['feat', i % 2 === 1 && 'feat--flip']}>
          <img class="feat__shot" src={`${base}img/${f.img}`} alt={f.alt} loading="lazy" />
          <div class="feat__copy">
            <h2 class="feat__t" data-i18n={f.t}>{f.tf}</h2>
            <p class="feat__b" data-i18n={f.b}>{f.bf}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Pillow key="restTwo" fallback="The hours that are not on snow still count." tone="ground" align="start" mark="tr" />

  <section class="day" data-enter="split" aria-label="The same afternoon">
    <div class="day__col col-a">
      <img class="day__shot" src={`${base}img/kurumayama.webp`} alt="Wide beginner slopes at Kurumayama" loading="lazy" />
      <span class="eyebrow" data-i18n="daySkierLabel">Skis</span>
      <h2 class="day__h" data-i18n="daySkierTitle">Big, gentle slopes. Nobody watching you fall over.</h2>
      <p class="day__b" data-i18n="daySkierBody">Kurumayama SKYPARK is wide open with no trees in the way.</p>
    </div>
    <div class="day__seam" aria-hidden="true"></div>
    <div class="day__col col-b">
      <img class="day__shot" src={`${base}img/ropeway.webp`} alt="The snow-covered lava plateau at the top of the ropeway" loading="lazy" />
      <span class="eyebrow" data-i18n="dayRestLabel">Doesn’t ski</span>
      <h2 class="day__h" data-i18n="dayRestTitle">Cable car to the 2,237 m viewing deck. No skis required.</h2>
      <p class="day__b" data-i18n="dayRestBody">Seven warm minutes up, and you’re standing on a snow-covered volcanic plateau.</p>
    </div>
    <p class="day__join" data-i18n="dayJoin">
      Both of you are back at the house before dark, in front of the same fire.
    </p>
  </section>

  <section class="section off" data-enter="settle">
    <p class="eyebrow" data-i18n="offEyebrow">The days in between</p>
    <div class="off__pair">
      <article class="off__one">
        <img class="off__shot" src={`${base}img/suwa.webp`} alt="Lake Suwa in winter" loading="lazy" />
        <h3 class="off__n" data-i18n="off1Name">Lake Suwa</h3>
        <span class="off__t" data-i18n="off1Time">30 min away</span>
        <p class="off__b" data-i18n="off1Body">A hot spring town on the water, an easy lakeside walk and a very old shrine.</p>
      </article>
      <article class="off__one">
        <img class="off__shot" src={`${base}img/narai.webp`} alt="Narai-juku street under snow" loading="lazy" />
        <h3 class="off__n" data-i18n="off2Name">Narai-juku</h3>
        <span class="off__t" data-i18n="off2Time">About an hour</span>
        <p class="off__b" data-i18n="off2Body">A whole street of 400-year-old wooden inns, under snow, with almost nobody in it.</p>
      </article>
    </div>
    <p class="off__close" data-i18n="offClose">Each one gets its own day. No rushing back for a 3pm lesson.</p>
  </section>

  <section class="section paper faq" data-enter="seam">
    <hr class="rule seam-rule" />
    <div class="seam-body">
      <p class="eyebrow" data-i18n="tsFaqEyebrow">Before you ask</p>
      <h2 class="display faq__title" data-i18n="tsFaqTitle">The three things everyone asks first.</h2>
      <dl class="faq__list">
        {faqs.map((f) => (
          <div class="faq__item">
            <dt class="faq__q" data-i18n={f.q}>{f.qf}</dt>
            <dd class="faq__a" data-i18n={f.a}>{f.af}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section getting" data-enter="dissolve">
    <p class="eyebrow" data-i18n="getEyebrow">Getting there is the easy bit</p>
    <h2 class="display getting__title" data-i18n="getTitle">One train out. One train back.</h2>
    <ol class="legs">
      {legs.map((l) => (
        <li class="leg">
          <span class="leg__dot" aria-hidden="true"></span>
          <div>
            <p class="leg__n" data-i18n={l.n}>{l.nf}</p>
            <p class="leg__b" data-i18n={l.b}>{l.bf}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="week">
    <p class="eyebrow" data-i18n="weekEyebrow">What the week looks like</p>
    <h2 class="display week__title" data-i18n="weekTitle">Day 1 → 7</h2>
    <ol class="week__list" data-enter="recede">
      {days.map((d) => (
        <li class="week__day">
          <p class="week__date">{d.d}</p>
          <p class="week__what" data-i18n={d.k}>{d.f}</p>
        </li>
      ))}
    </ol>
    <p class="week__close" data-i18n="weekClose">A sample week only — we build the days around your group.</p>
  </section>

  <section class="section ask" data-enter="settle">
    <h2 class="display ask__line" data-i18n="tsCtaLine">Give your family a different kind of winter this year.</h2>
    <a class="cta" href={INSTAGRAM} rel="noopener noreferrer" target="_blank" data-i18n="tsCtaBtn">
      Ask about 26/27 whole-house dates and pricing
    </a>
    <p class="ask__note" data-i18n="inviteBody">
      Tell us your dates, how many of you, and how many have never stood on skis.
    </p>
  </section>
</Layout>

<style>
  .hero { min-height: 100vh; padding: var(--inset); background: var(--ground); display: flex; }
  .hero__frame { position: relative; flex: 1; display: flex; align-items: flex-end; overflow: hidden; }
  .shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(14,14,14,0.2) 0%, rgba(14,14,14,0.35) 45%, rgba(14,14,14,0.85) 100%);
  }
  .hero__copy { position: relative; z-index: 2; padding: calc(var(--unit) * 5); max-width: 64ch; }
  .hero__title {
    font-size: clamp(2.1rem, 5.4vw, 4.4rem);
    margin: calc(var(--unit) * 2) 0 0;
    color: var(--ink-on-ground);
  }
  .hero__sub { margin-top: calc(var(--unit) * 3); color: var(--mute-on-ground); max-width: 56ch; }

  .feats__list { margin-top: calc(var(--unit) * 7); display: flex; flex-direction: column; gap: calc(var(--unit) * 9); }
  .feat { display: grid; grid-template-columns: 1.05fr 1fr; gap: calc(var(--unit) * 6); align-items: center; }
  .feat--flip .feat__shot { order: 2; }
  .feat__shot { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: var(--hair) solid var(--sage); }
  .feat__t {
    font-family: var(--serif); font-weight: var(--serif-weight);
    font-size: clamp(1.4rem, 3vw, 2.2rem); line-height: 1.25;
  }
  .feat__b { margin-top: calc(var(--unit) * 2.5); color: var(--mute-on-paper); max-width: 52ch; }

  .day { display: grid; grid-template-columns: 1fr var(--hair) 1fr; background: var(--paper); color: var(--ink-on-paper); }
  .day__col { display: flex; flex-direction: column; gap: calc(var(--unit) * 1.5); padding: var(--inset); }
  .day__seam { background: var(--accent); }
  .day__shot { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border: var(--hair) solid rgba(26,48,40,0.2); margin-bottom: calc(var(--unit) * 2); }
  .day__h { font-size: clamp(1.25rem, 2.4vw, 1.9rem); max-width: 20ch; }
  .day__b { color: var(--mute-on-paper); max-width: 44ch; font-size: 16px; }
  .day__join {
    grid-column: 1 / -1; border-top: var(--hair) solid rgba(26,48,40,0.2);
    padding: calc(var(--unit) * 5) var(--inset); text-align: center;
    font-family: var(--serif); font-weight: var(--serif-weight); font-size: clamp(1.05rem, 2.1vw, 1.5rem);
  }

  .off { background: var(--ground); }
  .off__pair { display: grid; grid-template-columns: 1fr 1fr; gap: calc(var(--unit) * 5); margin-top: calc(var(--unit) * 5); }
  .off__one { display: flex; flex-direction: column; gap: calc(var(--unit) * 1); }
  .off__shot { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: var(--hair) solid var(--sage); margin-bottom: calc(var(--unit) * 2); }
  .off__n { font-size: clamp(1.2rem, 2.2vw, 1.7rem); }
  .off__t { font-size: 13px; color: var(--accent); }
  .off__b { color: var(--mute-on-ground); font-size: 15px; }
  .off__close { margin-top: calc(var(--unit) * 5); color: var(--mute-on-ground); max-width: 50ch; }

  .faq__title { margin-top: calc(var(--unit) * 2); }
  .faq__list { margin: calc(var(--unit) * 6) 0 0; }
  .faq__item { padding: calc(var(--unit) * 3) 0; border-top: var(--hair) solid rgba(26,48,40,0.18); max-width: 82ch; }
  .faq__q {
    font-family: var(--serif); font-weight: var(--serif-weight);
    font-size: clamp(1.05rem, 2vw, 1.35rem); color: var(--ink-on-paper);
  }
  .faq__a { margin: calc(var(--unit) * 1.5) 0 0; color: var(--mute-on-paper); font-size: 16px; }

  .getting { background: var(--ground); }
  .getting__title { margin-top: calc(var(--unit) * 2); }
  .legs { list-style: none; margin: calc(var(--unit) * 6) 0 0; padding: 0; }
  .leg { display: flex; gap: calc(var(--unit) * 3); padding-bottom: calc(var(--unit) * 4); position: relative; }
  .leg:not(:last-child)::before {
    content: ''; position: absolute; left: 5px; top: 16px; bottom: 0;
    width: var(--hair); background: rgba(138,154,143,0.4);
  }
  .leg__dot { width: 11px; height: 11px; margin-top: 7px; flex-shrink: 0; background: var(--accent); }
  .leg__n { font-weight: 700; }
  .leg__b { color: var(--mute-on-ground); font-size: 15px; }

  .week { position: relative; background: var(--paper); color: var(--ink-on-paper); padding: calc(var(--unit) * 14) var(--inset); }
  .week__title { margin-top: calc(var(--unit) * 2); }
  .week__list { list-style: none; position: relative; margin: calc(var(--unit) * 8) 0 0; padding: 0; }
  .week__list::before { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: var(--hair); background: rgba(26,48,40,0.2); }
  .week__day { display: grid; grid-template-columns: 1fr 1fr; gap: calc(var(--unit) * 6); padding: calc(var(--unit) * 3) 0; }
  .week__day > * { grid-column: 1; text-align: right; padding-right: calc(var(--unit) * 4); }
  .week__day:nth-child(even) > * { grid-column: 2; text-align: left; padding-right: 0; padding-left: calc(var(--unit) * 4); }
  .week__date { font-family: var(--serif); font-weight: var(--serif-weight); font-size: clamp(1.1rem, 2.2vw, 1.6rem); transition: color var(--t-fast) var(--ease); }
  .week__day:hover .week__date { color: var(--accent); }
  .week__what { color: var(--mute-on-paper); font-size: 15px; }
  .week__close { margin-top: calc(var(--unit) * 6); color: var(--mute-on-paper); font-size: 14px; }

  .ask { background: var(--ground); display: flex; flex-direction: column; align-items: center; text-align: center; gap: calc(var(--unit) * 3); }
  .ask__line { max-width: 24ch; }
  .ask__note { font-size: 14px; color: var(--mute-on-ground); max-width: 44ch; }

  @media (max-width: 900px) {
    .feat { grid-template-columns: 1fr; gap: calc(var(--unit) * 3); }
    .feat--flip .feat__shot { order: 0; }
    .off__pair { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .day { grid-template-columns: 1fr; }
    .day__seam { height: 2px; }
    .week__list::before { left: 0; }
    .week__day { grid-template-columns: 1fr; gap: calc(var(--unit) * 1); }
    .week__day > *, .week__day:nth-child(even) > * {
      grid-column: 1; text-align: left; padding-right: 0; padding-left: calc(var(--unit) * 3);
    }
  }
</style>
