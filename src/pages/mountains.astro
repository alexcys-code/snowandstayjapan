---
import Layout from '../layouts/Layout.astro';
import Pillow from '../components/Pillow.astro';
import { resorts } from '../data/resorts';
import { nearby } from '../data/nearby';

const hakuba = (nearby.skiAreas ?? []).find((s) => /hakuba/i.test(s.name));
---

<Layout active="mountains" title="Mountains">
  <section class="word" data-enter="aperture">
    <h1 class="word__w" data-i18n="mtWord">Snow</h1>
    <hr class="word__rule" />
  </section>

  <section class="section paper choose" data-enter="seam">
    <hr class="rule seam-rule" />
    <div class="seam-body choose__body">
      <p class="eyebrow" data-i18n="mtChooseEyebrow">Thirteen resorts, one valley</p>
      <h2 class="display choose__title" data-i18n="mtChooseTitle">We pick the mountain. You pick nothing.</h2>
      <p class="lede choose__lede" data-i18n="mtChooseLede">
        Yatsugatake is a highland range in Nagano, two hours from Tokyo, ringed by thirteen small ski areas. None of them are famous, which is the point.
      </p>
    </div>
  </section>

  <section class="list" data-enter="dissolve" aria-label="Resorts by how well they suit beginners">
    {resorts.map((r) => (
      <article class:list={['row', r.ours && 'row--ours']}>
        <div class="row__id">
          <h3 class="row__name">{r.name}</h3>
          <p class="row__ja">{r.nameJa}</p>
          {r.ours && <span class="row__ours" data-i18n="mtOurs">We ski this one</span>}
        </div>

        <div class="row__data">
          {r.green !== null && r.total !== null ? (
            <>
              <div class="bar" role="img" aria-label={`${r.green} of ${r.total} courses are beginner`}>
                <span class="bar__fill" style={`width:${Math.round((r.green / r.total) * 100)}%`}></span>
              </div>
              <p class="row__stat">
                <strong>{r.green}</strong>/{r.total} <span data-i18n="mtBeginnerLabel">beginner courses</span>
              </p>
            </>
          ) : (
            <p class="row__stat row__stat--tbc" data-i18n="mtNoData">Course counts to confirm</p>
          )}
          {r.longestGreen && (
            <p class="row__long">
              <strong>{(r.longestGreen / 1000).toFixed(1)} km</strong>
              <span data-i18n="mtLongestLabel">longest beginner run</span>
            </p>
          )}
        </div>

        <ul class="chips">
          {r.carpet && <li data-i18n="mtCarpet">Magic carpet</li>}
          {r.kidsPark && <li data-i18n="mtKidsPark">Snow play area</li>}
          {r.nonSkierLift && <li data-i18n="mtNonSkier">Lift for non-skiers</li>}
          {r.night && <li data-i18n="mtNight">Night skiing</li>}
        </ul>

        {r.ours && <p class="row__note" data-i18n={r.noteKey}></p>}
      </article>
    ))}
  </section>

  <Pillow key="restOne" fallback="Snow out the front door." tone="paper" align="end" mark="bl" />

  {hakuba && (
    <section class="section hakuba" data-enter="settle">
      <hr class="rule" />
      <h2 class="display hakuba__h" data-i18n="hakubaTitle">And then there is Hakuba.</h2>
      <p class="lede hakuba__b" data-i18n="hakubaBody">
        World-class, and the most internationally famous skiing in Japan — which is exactly the problem in peak season.
      </p>
    </section>
  )}
</Layout>

<style>
  .word {
    min-height: 68vh;
    padding: var(--inset);
    background: var(--ground);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .word__w { font-size: clamp(4rem, 21vw, 14rem); line-height: 0.9; color: var(--ink-on-ground); }
  .word__rule {
    border: 0;
    height: 3px;
    background: var(--accent);
    width: min(320px, 46vw);
    margin: calc(var(--unit) * 4) 0 0;
  }

  .choose { padding-bottom: calc(var(--unit) * 6); }
  .choose__body { padding-top: calc(var(--unit) * 6); max-width: 66ch; }
  .choose__title { margin-top: calc(var(--unit) * 2); }
  .choose__lede { margin-top: calc(var(--unit) * 3); }

  .list {
    background: var(--paper);
    color: var(--ink-on-paper);
    padding: 0 var(--inset) calc(var(--unit) * 12);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 0.95fr);
    gap: calc(var(--unit) * 4);
    align-items: start;
    padding: calc(var(--unit) * 4) 0;
    border-top: var(--hair) solid rgba(26, 48, 40, 0.18);
  }
  .row--ours { border-left: 3px solid var(--accent); padding-left: calc(var(--unit) * 3); }

  .row__name {
    font-family: var(--serif);
    font-weight: var(--serif-weight);
    font-size: clamp(1.05rem, 2vw, 1.45rem);
    line-height: 1.25;
  }
  .row__ja { font-size: 12px; color: var(--mute-on-paper); margin-top: 3px; }
  .row__ours {
    display: inline-block;
    margin-top: calc(var(--unit) * 1.5);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .bar {
    height: 8px;
    background: rgba(26, 48, 40, 0.12);
    overflow: hidden;
  }
  .bar__fill { display: block; height: 100%; background: var(--accent); }
  .row__stat { margin-top: calc(var(--unit) * 1.5); font-size: 14px; color: var(--mute-on-paper); }
  .row__stat strong {
    font-family: var(--serif);
    font-weight: var(--serif-weight);
    font-size: 20px;
    color: var(--ink-on-paper);
  }
  .row__stat--tbc { margin-top: 0; font-style: italic; opacity: 0.65; }
  .row__long { margin-top: calc(var(--unit) * 1.5); font-size: 13px; color: var(--mute-on-paper); }
  .row__long strong {
    font-family: var(--serif);
    font-weight: var(--serif-weight);
    font-size: 17px;
    color: var(--ink-on-paper);
    margin-right: 6px;
  }

  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 5px; }
  .chips li { font-size: 13px; color: var(--ink-on-paper); }
  .chips li::before { content: '— '; color: var(--accent); }

  .row__note {
    grid-column: 1 / -1;
    margin-top: calc(var(--unit) * 1);
    max-width: 78ch;
    font-size: 15px;
    color: var(--mute-on-paper);
  }

  .hakuba { background: var(--ground); }
  .hakuba__h { margin-top: calc(var(--unit) * 5); }
  .hakuba__b { margin-top: calc(var(--unit) * 3); }

  @media (max-width: 900px) {
    .row { grid-template-columns: 1fr 1fr; }
    .chips { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; gap: calc(var(--unit) * 2); }
  }
  @media (max-width: 600px) {
    .row { grid-template-columns: 1fr; gap: calc(var(--unit) * 2); }
  }
</style>
