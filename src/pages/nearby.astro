---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SkiAreaCard from '../components/SkiAreaCard.astro';
import MapSection from '../components/MapSection.astro';
import { nearby } from '../data/nearby';

const base = import.meta.env.BASE_URL;
const skiAreas = nearby.skiAreas ?? [];
const totalRuns = skiAreas.reduce((s, a) => s + a.runs.reduce((r, run) => r + run.count, 0), 0);
const totalLifts = skiAreas.reduce((s, a) => s + a.lifts.reduce((l, lift) => l + lift.count, 0), 0);
const maxVertical = Math.max(...skiAreas.map(a => a.vertical_m));
// Separate Hakuba from the rest
const mainAreas = skiAreas.filter(a => a.slug !== 'hakuba' && a.name !== 'Hakuba Valley');
const hakuba = skiAreas.find(a => a.name === 'Hakuba Valley');
---

<Layout
  title="Nearby Ski Areas"
  description="Eight ski resorts near Yatsugatake — quieter, drier, and more authentic than the international crowds. Hakuba listed last for a reason."
>
  <header>
    <Nav active="nearby" />
  </header>

  <header class="city-hero" style={`--city-accent: ${nearby.accentColor}`}>
    <div class="city-hero-inner">
      <p class="city-eyebrow">{nearby.season} · {skiAreas.length} resorts · Yatsugatake region</p>
      <h1 class="city-title" data-i18n="nearbyTitle">Nearby Ski Areas</h1>
      <p class="city-tagline">{nearby.tagline}</p>
    </div>
    <div class="city-hero-accent-bar" style={`background: ${nearby.accentColor}`}></div>
  </header>

  <!-- Stats bar -->
  <div class="stats-bar">
    <div class="stats-inner">
      <div class="stat">
        <span class="stat-value">{skiAreas.length}</span>
        <span class="stat-label" data-i18n="statResorts">Resorts</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">{totalRuns}</span>
        <span class="stat-label" data-i18n="statTotalRuns">Total runs</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">{maxVertical}m</span>
        <span class="stat-label" data-i18n="statBestVertical">Best vertical</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">{nearby.season}</span>
        <span class="stat-label" data-i18n="statSeason">Season</span>
      </div>
    </div>
  </div>

  <main>
    <!-- Map -->
    <section class="section">
      <div class="container">
        <div class="section-label" data-i18n="labelOverview">OVERVIEW</div>
        <h2 class="section-title" data-i18n="nearbyGlance">Yatsugatake region at a glance</h2>
        <p class="section-intro" data-i18n="nearbyMapIntro">Eight resorts spread across Yamanashi and Nagano — all within an hour of Kobuchizawa by car.</p>
        <MapSection
          mapCenter={nearby.mapCenter}
          mapZoom={nearby.mapZoom}
          mapPoints={nearby.mapPoints}
          accentColor={nearby.accentColor}
        />
      </div>
    </section>

    <!-- Getting there -->
    <section class="section section-alt transport-section">
      <div class="container">
        <div class="section-label" data-i18n="labelGettingThere">GETTING THERE</div>
        <h2 class="section-title" data-i18n="gettingThereTitle">Base yourself in Kobuchizawa</h2>
        <div class="transport-bar" style={`border-left-color: ${nearby.accentColor}; background: ${nearby.accentColor}0D`}>
          <span class="transport-icon">🚄</span>
          <p class="transport-text" data-i18n="nearbyTransport">{nearby.transport}</p>
        </div>
      </div>
    </section>

    <!-- Main ski areas (not Hakuba) -->
    <section class="section">
      <div class="container">
        <div class="section-label" data-i18n="labelSkiAreas">SKI AREAS</div>
        <h2 class="section-title" data-i18n="nearbySkiTitle">The hidden gems</h2>
        <p class="section-intro" data-i18n="nearbySkiIntro">Quieter, drier, and more authentic — these seven resorts offer excellent skiing without the crowds that define the more famous destinations.</p>
        <div class="ski-grid">
          {mainAreas.map(area => (
            <SkiAreaCard area={area} accentColor={nearby.accentColor} />
          ))}
        </div>
      </div>
    </section>

    <!-- Hakuba — last, with warning banner -->
    {hakuba && (
      <section class="section section-alt hakuba-section">
        <div class="container">
          <div class="section-label" data-i18n="labelHakuba">AND IF YOU WANT THE CROWDS</div>
          <h2 class="section-title" data-i18n="hakubaTitle">Hakuba Valley</h2>
          <div class="hakuba-warning" data-i18n="hakubaWarning">
            World-class terrain — but Hakuba is one of Japan's most internationally recognised ski destinations. Expect lift queues, premium pricing, and fully booked accommodation during peak season. Listed last intentionally: explore the Yatsugatake region first.
          </div>
          <div class="ski-grid ski-grid-single">
            <SkiAreaCard area={hakuba} accentColor="#8B2010" />
          </div>
        </div>
      </section>
    )}

    <!-- Back nav -->
    <section class="section city-nav-section">
      <div class="container">
        <div class="city-nav">
          <a href={`${base}yatsugatake/`} class="city-nav-btn">← Yatsugatake</a>
          <a href={base} class="city-nav-btn" data-i18n="nextOverview">Back to Overview →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer footerText="⛷ Yatsugatake Winter Sports Guide" repoUrl="https://github.com/yourusername/yatsugatake-ski" />
</Layout>

<style>
  .city-hero {
    padding: 5rem 2rem 4rem;
    text-align: center;
    border-bottom: 1px solid var(--cream-dark);
    position: relative;
    background: radial-gradient(ellipse 60% 50% at 50% 60%, rgba(0,0,0,0.03), transparent);
  }
  .city-hero-inner { max-width: 760px; margin: 0 auto; }
  .city-eyebrow {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--city-accent);
    margin-bottom: 1rem;
  }
  .city-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 300;
    color: var(--ink);
    line-height: 1;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }
  .city-tagline {
    font-size: 1.05rem;
    color: var(--ink-muted);
    font-weight: 300;
    line-height: 1.6;
  }
  .city-hero-accent-bar {
    position: absolute;
    bottom: 0; left: 50%;
    transform: translateX(-50%);
    width: 40px; height: 3px;
    border-radius: 2px;
  }

  .stats-bar {
    background: white;
    border-bottom: 1px solid var(--cream-dark);
    padding: 1.25rem 2rem;
  }
  .stats-inner {
    max-width: 1100px; margin: 0 auto;
    display: flex; align-items: center;
    justify-content: center; gap: 0;
  }
  .stat { display: flex; flex-direction: column; align-items: center; gap: 0.1rem; padding: 0 2rem; }
  .stat-value { font-family: var(--font-display); font-size: 1.5rem; font-weight: 300; color: var(--ink); line-height: 1; }
  .stat-label { font-size: 0.65rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.1em; }
  .stat-divider { width: 1px; height: 2.5rem; background: var(--cream-dark); flex-shrink: 0; }

  .section { padding: 5rem 2rem; }
  .section-alt { background: white; }
  .container { max-width: 1100px; margin: 0 auto; }
  .section-label {
    font-size: 0.7rem; font-weight: 500; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--pt-green); margin-bottom: 0.75rem;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 300; color: var(--ink); margin-bottom: 1rem;
  }
  .section-intro {
    font-size: 1rem; color: var(--ink-muted);
    max-width: 660px; margin-bottom: 2.5rem; line-height: 1.75;
  }

  .transport-section { background: var(--cream); }
  .transport-bar {
    display: flex; align-items: flex-start; gap: 0.75rem;
    padding: 1rem 1.25rem; border-left: 3px solid;
    border-radius: 0 var(--radius) var(--radius) 0; max-width: 760px;
  }
  .transport-icon { font-size: 1.1rem; flex-shrink: 0; }
  .transport-text { font-size: 0.875rem; color: var(--ink-muted); line-height: 1.7; }

  .ski-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.25rem;
  }
  .ski-grid-single { grid-template-columns: minmax(340px, 600px); }

  .hakuba-section { background: #FFF8F6; }
  .hakuba-warning {
    font-size: 0.9rem;
    color: #7A3520;
    background: #FDECEA;
    border: 1px solid #F5C6BC;
    border-left: 4px solid #C0392B;
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 0.875rem 1.25rem;
    margin-bottom: 2rem;
    max-width: 700px;
    line-height: 1.7;
  }

  .city-nav-section { padding: 3rem 2rem; background: white; border-top: 1px solid var(--cream-dark); }
  .city-nav { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .city-nav-btn {
    font-family: var(--font-display); font-size: 1rem;
    color: var(--ink-muted); padding: 0.75rem 1.5rem;
    border: 1px solid var(--cream-dark); border-radius: var(--radius);
    background: var(--cream); transition: background 0.2s, color 0.2s;
  }
  .city-nav-btn:hover { background: var(--cream-dark); color: var(--ink); }

  @media (max-width: 600px) {
    .city-hero { padding: 4rem 1.5rem 3rem; }
    .section { padding: 3rem 1.25rem; }
    .ski-grid { grid-template-columns: 1fr; }
    .city-nav { flex-direction: column; }
    .city-nav-btn { width: 100%; text-align: center; }
    .stats-inner { flex-wrap: wrap; gap: 1rem; }
    .stat-divider { display: none; }
    .stat { padding: 0 1rem; }
  }
</style>
