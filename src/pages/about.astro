---
import Layout from '../layouts/Layout.astro';
import Pillow from '../components/Pillow.astro';
import { INSTAGRAM } from '../data/copy';
const base = import.meta.env.BASE_URL;

const notes = [
  { n: 'aboutN1', nf: 'A Japanese–Malaysian team', b: 'aboutN1b', bf: 'Based in Nagano. We answer in English, Japanese, Chinese and Malay.' },
  { n: 'aboutN2', nf: 'One group at a time', b: 'aboutN2b', bf: 'We do not run two bookings in the same week.' },
  { n: 'aboutN3', nf: 'We drive', bf: 'Station, slopes, onsen, old towns. All of it.', b: 'aboutN3b' },
];
---

<Layout active="about" title="About">
  <section class="manifesto paper" data-enter="dissolve">
    <div class="manifesto__body">
      <p class="manifesto__lead" data-i18n="aboutLead">
        We started doing this because we kept watching the same holiday go wrong.
      </p>
      <p data-i18n="aboutP1">
        A family flies to Japan for the snow. They book a big resort, because that is what you do.
      </p>
      <p data-i18n="aboutP2">
        So we stopped selling ski trips and started renting out a base with a driver and a coach attached — a resort hotel or a whole traditional house, whichever suits the group.
      </p>
      <p data-i18n="aboutP3">
        The mountains here are smaller than Niseko and emptier than Hakuba.
      </p>
    </div>
    <aside class="manifesto__notes">
      {notes.map((n) => (
        <div class="note">
          <p class="note__n" data-i18n={n.n}>{n.nf}</p>
          <p class="note__b" data-i18n={n.b}>{n.bf}</p>
        </div>
      ))}
    </aside>
  </section>

  <section class="section paper sia" data-enter="seam">
    <hr class="rule seam-rule" />
    <div class="seam-body sia__body">
      <p class="eyebrow" data-i18n="abSiaEyebrow">If you want something to show for it</p>
      <h2 class="display sia__title" data-i18n="abSiaTitle">You can take a ski badge while you are here.</h2>
      <p class="lede sia__lede" data-i18n="abSiaBody">
        The Professional Ski Instructors Association of Japan runs internationally recognised technical certifications, including a junior grade for children.
      </p>
    </div>
  </section>

  <section class="section nonski" data-enter="settle">
    <p class="eyebrow" data-i18n="abNonEyebrow">For the half of the group that does not ski</p>
    <h2 class="display nonski__title" data-i18n="abNonTitle">
      There is a whole winter that has nothing to do with skiing.
    </h2>
    <p class="lede nonski__lede" data-i18n="abNonBody">
      Nobody should spend the week in a canteen waiting for the others.
    </p>
    <ul class="nonski__list">
      <li data-i18n="abAct1">Strawberry picking in a heated greenhouse</li>
      <li data-i18n="abAct2">Ice fishing for wakasagi on a frozen lake</li>
      <li data-i18n="abAct3">Snowmobile rides</li>
      <li data-i18n="abAct4">Snowshoe walks through the birch forest</li>
    </ul>
  </section>

  <section class="section paper closing" data-enter="aperture">
    <div>
      <img class="closing__shot" src={`${base}img/window-view.jpg`} alt="The snowy peaks seen from a window of the house" loading="lazy" />
    </div>
  </section>

  <Pillow key="restTwo" fallback="The hours that are not on snow still count." tone="ground" align="end" mark="br" />

  <section class="section ask" data-enter="settle">
    <h2 class="display" data-i18n="inviteTitle">The season is open.</h2>
    <p class="lede ask__lede" data-i18n="inviteBody">
      Tell us how many are travelling and how many want to ski.
    </p>
    <a class="cta" href={INSTAGRAM} rel="noopener noreferrer" target="_blank" data-i18n="inviteCta">DM us “SNOW”</a>
  </section>
</Layout>

<style>
  .manifesto {
    display: grid;
    grid-template-columns: minmax(0, 62ch) minmax(0, 22ch);
    gap: calc(var(--unit) * 8);
    padding: calc(var(--unit) * 16) var(--inset) calc(var(--unit) * 10);
  }
  .manifesto__body {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unit) * 3);
    font-size: 19px;
    line-height: 1.85;
  }
  .manifesto__lead {
    font-family: var(--serif);
    font-weight: var(--serif-weight);
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    line-height: 1.3;
    margin-bottom: calc(var(--unit) * 2);
  }
  .manifesto__lead::first-letter { color: var(--accent); }

  .manifesto__notes {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unit) * 5);
    padding-top: calc(var(--unit) * 2);
  }
  .note {
    padding-top: calc(var(--unit) * 1.5);
    border-top: var(--hair) solid var(--sage);
  }
  .note__n { font-size: 13px; font-weight: 700; }
  .note__b { font-size: 13px; color: var(--mute-on-paper); margin-top: 4px; }

  .sia__body { padding-top: calc(var(--unit) * 6); max-width: 70ch; }
  .sia__title { margin-top: calc(var(--unit) * 2); }
  .sia__lede { margin-top: calc(var(--unit) * 3); }

  .nonski { background: var(--ground); }
  .nonski__title { margin-top: calc(var(--unit) * 2); max-width: 22ch; }
  .nonski__lede { margin-top: calc(var(--unit) * 3); }
  .nonski__list {
    list-style: none;
    margin: calc(var(--unit) * 5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(var(--unit) * 2) calc(var(--unit) * 5);
    max-width: 76ch;
  }
  .nonski__list li {
    padding-top: calc(var(--unit) * 1.5);
    border-top: var(--hair) solid rgba(138, 154, 143, 0.4);
    font-size: 15px;
    color: var(--ink-on-ground);
  }
  @media (max-width: 640px) {
    .nonski__list { grid-template-columns: 1fr; }
  }

  .closing { padding-top: 0; }
  .closing__shot {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    margin-top: calc(var(--unit) * 6);
    border: var(--hair) solid var(--sage);
  }

  .ask {
    background: var(--ground);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: calc(var(--unit) * 3);
  }
  .ask__lede { max-width: 46ch; }

  @media (max-width: 860px) {
    .manifesto {
      grid-template-columns: 1fr;
      padding-top: calc(var(--unit) * 10);
      gap: calc(var(--unit) * 6);
    }
  }
</style>
