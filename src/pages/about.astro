---
import Layout from '../layouts/Layout.astro';
import Pillow from '../components/Pillow.astro';
import { INSTAGRAM } from '../data/copy';
const base = import.meta.env.BASE_URL;

const notes = [
  { n: 'aboutN1', nf: 'Based in Chino, Nagano', b: 'aboutN1b', bf: 'Two hours from Shinjuku on one train.' },
  { n: 'aboutN2', nf: 'One group at a time', b: 'aboutN2b', bf: 'We do not run two bookings in the same week.' },
  { n: 'aboutN3', nf: 'We drive', bf: 'Station, slopes, onsen, old towns. All of it.', b: 'aboutN3b' },
];
---

<Layout active="about" title="About">
  <section class="manifesto paper" data-enter="dissolve">
    <div class="manifesto__body">
      <p class="manifesto__lead" data-i18n="aboutLead">
        We started doing this because we kept watching the same holiday go wrong.
      </p>
      <p data-i18n="aboutP1">
        A family flies to Japan for the snow. They book a big resort, because that is what you do.
      </p>
      <p data-i18n="aboutP2">
        So we stopped selling ski trips and started renting a house with a driver attached.
      </p>
      <p data-i18n="aboutP3">
        The mountains here are smaller than Niseko and emptier than Hakuba.
      </p>
    </div>
    <aside class="manifesto__notes">
      {notes.map((n) => (
        <div class="note">
          <p class="note__n" data-i18n={n.n}>{n.nf}</p>
          <p class="note__b" data-i18n={n.b}>{n.bf}</p>
        </div>
      ))}
    </aside>
  </section>

  <section class="section paper closing" data-enter="seam">
    <hr class="rule seam-rule" />
    <div class="seam-body">
      <img class="closing__shot" src={`${base}img/window-view.jpg`} alt="The snowy peaks seen from a window of the house" loading="lazy" />
    </div>
  </section>

  <Pillow key="restTwo" fallback="Christmas morning happens in a living room." tone="ground" align="end" mark="br" />

  <section class="section ask" data-enter="settle">
    <h2 class="display" data-i18n="inviteTitle">Christmas dates are open.</h2>
    <p class="lede ask__lede" data-i18n="inviteBody">
      Tell us how many are travelling and how many want to ski.
    </p>
    <a class="cta" href={INSTAGRAM} rel="noopener noreferrer" target="_blank" data-i18n="inviteCta">DM us “SNOW”</a>
  </section>
</Layout>

<style>
  .manifesto {
    display: grid;
    grid-template-columns: minmax(0, 62ch) minmax(0, 22ch);
    gap: calc(var(--unit) * 8);
    padding: calc(var(--unit) * 16) var(--inset) calc(var(--unit) * 10);
  }
  .manifesto__body {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unit) * 3);
    font-size: 19px;
    line-height: 1.85;
  }
  .manifesto__lead {
    font-family: var(--serif);
    font-weight: var(--serif-weight);
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    line-height: 1.3;
    margin-bottom: calc(var(--unit) * 2);
  }
  .manifesto__lead::first-letter { color: var(--accent); }

  .manifesto__notes {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unit) * 5);
    padding-top: calc(var(--unit) * 2);
  }
  .note {
    padding-top: calc(var(--unit) * 1.5);
    border-top: var(--hair) solid var(--sage);
  }
  .note__n { font-size: 13px; font-weight: 700; }
  .note__b { font-size: 13px; color: var(--mute-on-paper); margin-top: 4px; }

  .closing { padding-top: 0; }
  .closing__shot {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    margin-top: calc(var(--unit) * 6);
    border: var(--hair) solid var(--sage);
  }

  .ask {
    background: var(--ground);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: calc(var(--unit) * 3);
  }
  .ask__lede { max-width: 46ch; }

  @media (max-width: 860px) {
    .manifesto {
      grid-template-columns: 1fr;
      padding-top: calc(var(--unit) * 10);
      gap: calc(var(--unit) * 6);
    }
  }
</style>
