---
import Layout from '../layouts/Layout.astro';
import Pillow from '../components/Pillow.astro';
import { INSTAGRAM } from '../data/copy';
const base = import.meta.env.BASE_URL;
---

<Layout active="home">
  <section class="threshold" data-enter="aperture">
    <div class="threshold__frame frame">
      <img class="shot" src={`${base}img/house-exterior.jpg`} alt="" fetchpriority="high" />
      <div class="scrim"></div>
      <div class="threshold__copy">
        <p class="eyebrow" data-i18n="homeEyebrow">Yatsugatake, Nagano · 2 hours from Tokyo</p>
        <h1 class="threshold__title" data-i18n="homeTitle">Two hours from Tokyo. Snow all winter. Almost nobody there.</h1>
        <p class="threshold__lede" data-i18n="homeLede">
          Yatsugatake is a range of highlands in Nagano, two hours from Shinjuku on a single train. Thirteen small ski areas, dry snow from December to March, and none of the queues you get at Niseko or Hakuba. We book the base, drive you everywhere, and put a coach on the snow with you — you can arrive knowing nothing about skiing and it still works.
        </p>
      </div>
    </div>
  </section>

  <Pillow key="restOne" fallback="Snow out the front door." tone="ground" align="end" mark="br" />

  <section class="promise section paper" data-enter="seam">
    <hr class="rule seam-rule" />
    <div class="seam-body promise__body">
      <h2 class="display" data-i18n="promiseTitle">One base. We do all the driving.</h2>
      <p class="lede promise__lede" data-i18n="promiseBody">
        You take one train out of Tokyo and we meet you at the station. After that every transfer is ours — the daily run to the slopes, the onsen and old-town days, and the ride out at the end.
      </p>
    </div>
  </section>

  <section id="how" class="apertures" data-enter="recede" aria-label="Stay, ski, rest">
    <article class="aperture aperture--1" tabindex="0">
      <img class="shot" src={`${base}img/bedroom.jpg`} alt="A bedroom in the kominka — timber beams and made-up beds" loading="lazy" />
      <div class="aperture__label">
        <span class="eyebrow" data-i18n="apStayLabel">Your base</span>
        <span class="aperture__name" data-i18n="apStayName">A hotel or an old Japanese house</span>
      </div>
    </article>
    <article class="aperture aperture--2" tabindex="0">
      <img class="shot" src={`${base}img/kiyosato.jpg`} alt="Skiers on a wide beginner slope with Mount Fuji beyond" loading="lazy" />
      <div class="aperture__label">
        <span class="eyebrow" data-i18n="apSkiLabel">You ski here</span>
        <span class="aperture__name" data-i18n="apSkiName">Quiet beginner slopes</span>
      </div>
    </article>
    <article class="aperture aperture--3" tabindex="0">
      <img class="shot" src={`${base}img/narai.webp`} alt="The old post town at Narai-juku under snow" loading="lazy" />
      <div class="aperture__label">
        <span class="eyebrow" data-i18n="apRestLabel">You rest here</span>
        <span class="aperture__name" data-i18n="apRestName">Onsen and old towns</span>
      </div>
    </article>
  </section>

  <Pillow key="restTwo" fallback="The hours that are not on snow still count." tone="paper" align="start" mark="tr" />

  <section class="invite section" data-enter="settle">
    <h2 class="display invite__title" data-i18n="inviteTitle">Tell us when, and who has never skied.</h2>
    <p class="lede invite__lede" data-i18n="inviteBody">
      We build the week around your group — your dates, how many of you, how many have never stood on skis. Send us that and we will send back a plan with a price on it.
    </p>
    <a class="cta" href={INSTAGRAM} rel="noopener noreferrer" target="_blank" data-i18n="inviteCta">DM us “SNOW”</a>
    <a class="invite__open" href={`${base}stays/`}>
      <span class="invite__dot" aria-hidden="true"></span>
      <span data-i18n="homeOpenNow">Two bases open — Kobuchizawa and Tateshina</span>
    </a>
  </section>
</Layout>

<style>
  .threshold {
    min-height: 100vh;
    padding: var(--inset);
    background: var(--ground);
    display: flex;
  }
  .threshold__frame {
    position: relative;
    flex: 1;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .threshold__copy {
    position: relative;
    z-index: 2;
    padding: calc(var(--unit) * 5);
    max-width: 62ch;
  }
  .threshold__title {
    font-size: clamp(2.4rem, 6.4vw, 5.2rem);
    margin: calc(var(--unit) * 2) 0 0;
    color: var(--ink-on-ground);
  }
  .threshold__lede {
    margin-top: calc(var(--unit) * 3);
    color: var(--mute-on-ground);
    max-width: 54ch;
  }

  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(14, 14, 14, 0.2) 0%, rgba(14, 14, 14, 0.35) 45%, rgba(14, 14, 14, 0.82) 100%);
  }

  .promise { padding-top: calc(var(--unit) * 10); }
  .promise__body { padding-top: calc(var(--unit) * 6); max-width: 68ch; }
  .promise__lede { margin-top: calc(var(--unit) * 3); }
  .promise__body h2::first-letter { color: var(--accent); }

  .apertures {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--unit) * 2);
    padding: calc(var(--unit) * 12) var(--inset);
    background: var(--ground);
  }
  .aperture {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: var(--hair) solid var(--sage);
    overflow: hidden;
    cursor: default;
  }
  .aperture--1 { max-width: 900px; }
  .aperture--2 { max-width: 720px; }
  .aperture--3 { max-width: 560px; border-color: var(--accent); }

  .aperture::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(14, 14, 14, 0) 45%, rgba(14, 14, 14, 0.72) 100%);
  }
  .aperture .shot { transition: transform var(--t-slow) var(--ease); }
  .aperture:hover .shot { transform: scale(1.03); }

  .aperture__label {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: calc(var(--unit) * 1.5);
    padding: calc(var(--unit) * 1.5) calc(var(--unit) * 2.5);
    background: var(--ground);
    color: var(--ink-on-ground);
    max-width: calc(100% - var(--unit) * 3);
  }
  .aperture__label .eyebrow { color: var(--accent-lift); }
  .aperture__name {
    font-family: var(--serif);
    font-weight: var(--serif-weight);
    font-size: clamp(1.05rem, 1.9vw, 1.5rem);
    line-height: 1.25;
  }

  .invite {
    background: var(--ground);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--unit) * 3);
  }
  .invite__lede { max-width: 48ch; }
  .invite__open {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--unit) * 1.5);
    margin-top: calc(var(--unit) * 2);
    padding: calc(var(--unit) * 1.5) calc(var(--unit) * 3);
    border: var(--hair) solid rgba(138, 154, 143, 0.45);
    font-size: 14px;
    color: var(--mute-on-ground);
    text-decoration: none;
    transition: border-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .invite__open:hover,
  .invite__open:focus-visible {
    border-color: var(--accent);
    color: var(--ink-on-ground);
  }
  .invite__dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    background: var(--accent);
  }

  @media (max-width: 860px) {
    .apertures { padding: calc(var(--unit) * 8) var(--inset); }
    .aperture--1,
    .aperture--2,
    .aperture--3 { max-width: 100%; }
  }
</style>
