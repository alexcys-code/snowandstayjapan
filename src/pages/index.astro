---
import Layout from '../layouts/Layout.astro';
import Pillow from '../components/Pillow.astro';
import { INSTAGRAM } from '../data/copy';
const base = import.meta.env.BASE_URL;
---

<Layout active="home">
  <section class="threshold" data-enter="aperture">
    <div class="threshold__frame frame">
      <div class="slot slot--hero" data-slot="Kominka exterior, snow"></div>
      <div class="threshold__copy">
        <p class="eyebrow" data-i18n="homeEyebrow">Dec 23 – 29 · Tateshina, Nagano</p>
        <h1 class="threshold__title" data-i18n="homeTitle">Christmas in a 150-year-old kominka.</h1>
        <p class="threshold__lede" data-i18n="homeLede">
          A kominka is an old Japanese country house. This one is yours for the week — with snow out the front door and the kids learning to ski before New Year.
        </p>
      </div>
    </div>
  </section>

  <Pillow key="restOne" fallback="Snow out the front door." tone="ground" align="end" mark="br" />

  <section class="promise section paper" data-enter="seam">
    <hr class="rule seam-rule" />
    <div class="seam-body promise__body">
      <h2 class="display" data-i18n="promiseTitle">One house. We do all the driving.</h2>
      <p class="lede promise__lede" data-i18n="promiseBody">
        You take one train out of Tokyo. We meet you at the station and drive you the last 25 minutes to the door.
      </p>
    </div>
  </section>

  <section class="apertures" data-enter="recede" aria-label="Stay, ski, rest">
    <article class="aperture aperture--1" tabindex="0">
      <div class="slot" data-slot="The house"></div>
      <div class="aperture__panel"></div>
      <div class="aperture__label">
        <span class="eyebrow" data-i18n="apStayLabel">You sleep here</span>
        <span class="aperture__name" data-i18n="apStayName">Kominka Kozumi</span>
      </div>
    </article>
    <article class="aperture aperture--2" tabindex="0">
      <div class="slot" data-slot="The slopes"></div>
      <div class="aperture__panel"></div>
      <div class="aperture__label">
        <span class="eyebrow" data-i18n="apSkiLabel">You ski here</span>
        <span class="aperture__name" data-i18n="apSkiName">Kurumayama &amp; Pilatus</span>
      </div>
    </article>
    <article class="aperture aperture--3" tabindex="0">
      <div class="slot" data-slot="Suwa, Narai-juku"></div>
      <div class="aperture__panel"></div>
      <div class="aperture__label">
        <span class="eyebrow" data-i18n="apRestLabel">You rest here</span>
        <span class="aperture__name" data-i18n="apRestName">Suwa &amp; Narai-juku</span>
      </div>
    </article>
  </section>

  <Pillow key="restTwo" fallback="Christmas morning happens in a living room." tone="paper" align="start" mark="tr" />

  <section class="invite section" data-enter="settle">
    <h2 class="display invite__title" data-i18n="inviteTitle">Christmas dates are open.</h2>
    <p class="lede invite__lede" data-i18n="inviteBody">
      Tell us how many are travelling and how many want to ski. We’ll send back the week, with a price on it.
    </p>
    <a class="cta" href={INSTAGRAM} rel="noopener noreferrer" target="_blank" data-i18n="inviteCta">DM us “SNOW”</a>
    <a class="invite__more" href={`${base}stay/`} data-i18n="navStay">The week</a>
  </section>
</Layout>

<style>
  .threshold {
    min-height: 100vh;
    padding: var(--inset);
    background: var(--ground);
    display: flex;
  }
  .threshold__frame {
    position: relative;
    flex: 1;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .threshold__copy {
    position: relative;
    z-index: 2;
    padding: calc(var(--unit) * 5);
    max-width: 62ch;
  }
  .threshold__title {
    font-size: clamp(2.4rem, 6.4vw, 5.2rem);
    margin: calc(var(--unit) * 2) 0 0;
    color: var(--ink-on-ground);
  }
  .threshold__lede {
    margin-top: calc(var(--unit) * 3);
    color: var(--mute-on-ground);
    max-width: 54ch;
  }

  .slot {
    position: absolute;
    inset: 0;
    background: rgba(245, 240, 232, 0.05);
    display: grid;
    place-items: center;
  }
  .slot::after {
    content: attr(data-slot);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.28);
  }
  .slot--hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(14, 14, 14, 0.1) 0%, rgba(14, 14, 14, 0.55) 100%);
    z-index: 1;
  }
  .slot--hero::after {
    position: absolute;
    right: calc(var(--unit) * 2);
    top: calc(var(--unit) * 2);
  }

  .promise { padding-top: calc(var(--unit) * 10); }
  .promise__body { padding-top: calc(var(--unit) * 6); max-width: 68ch; }
  .promise__lede { margin-top: calc(var(--unit) * 3); }
  .promise__body h2::first-letter { color: var(--accent); }

  .apertures {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 96vh;
    padding: var(--inset);
    background: var(--ground);
  }
  .aperture {
    position: absolute;
    display: flex;
    align-items: flex-end;
    border: var(--hair) solid var(--sage);
    overflow: hidden;
    cursor: default;
  }
  .aperture--1 { width: min(88vw, 960px); aspect-ratio: 16 / 9; }
  .aperture--2 { width: min(64vw, 690px); aspect-ratio: 16 / 9; }
  .aperture--3 { width: min(41vw, 440px); aspect-ratio: 16 / 9; border-color: var(--accent); }

  .aperture__panel {
    position: absolute;
    inset: 0;
    background: var(--paper);
    transition: transform var(--t-slow) var(--ease);
    z-index: 1;
  }
  .aperture:hover .aperture__panel,
  .aperture:focus-visible .aperture__panel { transform: translateX(-101%); }

  .aperture__label {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: calc(var(--unit) * 2);
    mix-blend-mode: difference;
    color: #fff;
  }
  .aperture__label .eyebrow { color: var(--accent); }
  .aperture__name {
    font-family: var(--serif);
    font-weight: var(--serif-weight);
    font-size: clamp(1.1rem, 2vw, 1.6rem);
  }

  .invite {
    background: var(--ground);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--unit) * 3);
  }
  .invite__lede { max-width: 48ch; }
  .invite__more {
    font-size: 14px;
    color: var(--mute-on-ground);
  }

  @media (max-width: 860px) {
    .apertures {
      display: flex;
      flex-direction: column;
      gap: calc(var(--unit) * 3);
      min-height: 0;
      padding: calc(var(--unit) * 8) var(--inset);
    }
    .aperture,
    .aperture--1,
    .aperture--2,
    .aperture--3 { position: relative; width: 100%; }
    .aperture__panel { display: none; }
  }
</style>
