---
interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'A travel guide to Yatsugatake & Tokyo — Japan 2026',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} — Japan 2026` : 'Japan 2026';
const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Japan 2026" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!-- PWA -->
    <meta name="theme-color" content="#C9243F" />
    <link rel="manifest" href={`${base}manifest.json`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="base-url" content={base} />

    <title>{pageTitle}</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      crossorigin="anonymous"
    />

    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      :root {
        --cream: #FAF7F2;
        --cream-dark: #EBE6DC;
        --ink: #1A1818;
        --ink-muted: #6B6460;
        --ink-faint: #A8A299;
        --font-display: 'Cormorant Garamond', Georgia, serif;
        --font-body: 'Jost', system-ui, sans-serif;
        --radius: 6px;
        --radius-lg: 12px;
        --pt-green: #C9243F;
        --pt-yellow: #D4A017;
        --green: #2D6A4F;
        --green-light: #E6F4ED;
        --gold: #D97706;
        --gold-light: #FEF3C7;
        --terra: #B5560A;
        --terra-light: #FAEAE5;
      }

      body {
        font-family: var(--font-body);
        background: var(--cream);
        color: var(--ink);
        line-height: 1.6;
      }

      /* Tile pattern */
      .tile-pattern {
        background-image: repeating-linear-gradient(
          45deg,
          transparent,
          transparent 20px,
          var(--cream-dark) 20px,
          var(--cream-dark) 21px
        );
      }

      /* Sticky nav */
      header nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(250, 247, 242, 0.92);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--cream-dark);
        padding: 0.75rem 2rem;
      }

      .nav-inner {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .nav-brand {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 500;
      }

      .nav-links {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        margin-left: auto;
      }

      .nav-links a {
        font-size: 0.8rem;
        padding: 0.3rem 0.75rem;
        border-radius: 20px;
        color: var(--ink-muted);
        transition: color 0.2s, background 0.2s;
      }

      .nav-links a:hover,
      .nav-links a.active {
        color: var(--pt-green);
        background: rgba(201, 36, 63, 0.08);
      }

      /* Fade-up animation */
      .fade-up {
        animation: fadeUp 0.6s ease forwards;
      }

      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .delay-1 { animation-delay: 0.1s; }
      .delay-2 { animation-delay: 0.2s; }
      .delay-3 { animation-delay: 0.3s; }

      /* Mobile nav */
      @media (max-width: 600px) {
        .nav-links {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <!-- PWA Update Banner -->
    <div
      id="update-banner"
      style="display:none;position:fixed;bottom:1rem;left:50%;transform:translateX(-50%);background:var(--ink);color:white;padding:0.75rem 1.25rem;border-radius:var(--radius-lg);z-index:9999;display:none;align-items:center;gap:1rem;font-size:0.85rem;box-shadow:0 4px 20px rgba(0,0,0,0.3);"
    >
      <span>A new version is available.</span>
      <button
        onclick="location.reload()"
        style="background:var(--pt-green);color:white;border:none;padding:0.35rem 0.9rem;border-radius:20px;cursor:pointer;font-size:0.8rem;font-family:var(--font-body);"
      >Refresh</button>
      <button
        onclick="document.getElementById('update-banner').style.display='none'"
        style="background:transparent;color:rgba(255,255,255,0.6);border:none;cursor:pointer;font-size:1rem;line-height:1;padding:0 0.25rem;"
        aria-label="Dismiss"
      >×</button>
    </div>

    <slot />

