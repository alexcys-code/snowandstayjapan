  function applyLanguage(lang) {
    var t = TRANSLATIONS[lang] || TRANSLATIONS.en;

    // Update all data-i18n elements
    document.querySelectorAll('[data-i18n]').forEach(function(el) {
      var key = el.getAttribute('data-i18n');
      if (t[key] !== undefined) el.textContent = t[key];
    });

    // Update content cards
    document.querySelectorAll('[data-translations]').forEach(function(card) {
      if (lang === 'en') {
        // Restore original English content
        card.querySelectorAll('[data-field][data-orig]').forEach(function(field) {
          field.textContent = field.getAttribute('data-orig');
        });
        return;
      }
      try {
        var trans = JSON.parse(card.getAttribute('data-translations'));
        var langData = trans[lang];
        if (!langData) return;
        Object.keys(langData).forEach(function(field) {
          // Handle tags array
          if (field === 'tags' && Array.isArray(langData[field])) {
            var tagEls = card.querySelectorAll('.tag:not(.price-tag)');
            langData[field].forEach(function(text, i) {
              if (tagEls[i]) tagEls[i].textContent = text;
            });
            return;
          }
          // Handle activities array
          if (field === 'activities' && Array.isArray(langData[field])) {
            langData[field].forEach(function(text, i) {
              var el = card.querySelector('[data-field="activity-' + i + '"]');
              if (el) {
                if (!el.getAttribute('data-orig')) el.setAttribute('data-orig', el.textContent);
                el.textContent = text;
              }
            });
            return;
          }
          var el = card.querySelector('[data-field="' + field + '"]');
          if (el) {
            // Save original English on first switch
            if (!el.getAttribute('data-orig')) el.setAttribute('data-orig', el.textContent);
            el.textContent = langData[field];
          }
        });
      } catch(e) {}
    });

    // Update city-specific heading templates
    document.querySelectorAll('[data-i18n-hotels]').forEach(function(el) {
      var city = el.getAttribute('data-i18n-hotels');
      if (lang === 'zh') el.textContent = city + '的飯店';
      else if (lang === 'ja') el.textContent = city + 'のホテル';
      else el.textContent = 'Hotels in ' + city;
    });
    document.querySelectorAll('[data-i18n-restaurants]').forEach(function(el) {
      var city = el.getAttribute('data-i18n-restaurants');
      if (lang === 'zh') el.textContent = city + '的餐廳';
      else if (lang === 'ja') el.textContent = city + 'のレストラン';
      else el.textContent = 'Restaurants in ' + city;
    });
    document.querySelectorAll('[data-i18n-glance]').forEach(function(el) {
      var city = el.getAttribute('data-i18n-glance');
      if (lang === 'zh') el.textContent = city + '一覽';
      else if (lang === 'ja') el.textContent = city + '概観';
      else el.textContent = city + ' at a glance';
    });

    // Update explore buttons
    document.querySelectorAll('[data-i18n-explore]').forEach(function(el) {
      var city = el.getAttribute('data-i18n-explore');
      if (lang === 'zh') el.textContent = '探索' + city + ' →';
      else if (lang === 'ja') el.textContent = city + 'を詳しく見る →';
      else el.textContent = 'Explore ' + city + ' →';
    });

    // Update active button state
    document.querySelectorAll('.lang-btn').forEach(function(btn) {
      btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
    });

    document.documentElement.lang = lang === 'zh' ? 'zh-TW' : lang;
    localStorage.setItem('japan-lang', lang);
  }

  function initLang() {
    var saved = localStorage.getItem('japan-lang') || 'en';
    applyLanguage(saved);
  }

  document.addEventListener('DOMContentLoaded', function() {
    initLang();
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.lang-btn');
      if (btn) applyLanguage(btn.getAttribute('data-lang'));
    });
  });
})();
</script>

    <script is:inline>
      (function () {
        const base = document.querySelector('meta[name="base-url"]')?.getAttribute('content') || '/';
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register(base + 'sw.js').then(function (reg) {
              reg.addEventListener('updatefound', function () {
                const newWorker = reg.installing;
                if (newWorker) {
                  newWorker.addEventListener('statechange', function () {
                    if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                      const banner = document.getElementById('update-banner');
                      if (banner) banner.style.display = 'flex';
                    }
                  });
                }
              });
            }).catch(function () {});
          });
        }
      })();
    </script>
