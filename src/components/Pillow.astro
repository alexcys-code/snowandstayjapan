---
interface Props {
  key: string;
  fallback: string;
  tone?: 'ground' | 'paper';
  align?: 'start' | 'end';
  mark?: 'tr' | 'br' | 'bl' | 'none';
}
const { key, fallback, tone = 'ground', align = 'end', mark = 'br' } = Astro.props;
---

<section class:list={['pillow', tone === 'paper' && 'paper', `pillow--${align}`]}>
  <p class="pillow__line" data-i18n={key}>{fallback}</p>
  {mark !== 'none' && <span class:list={['pillow__mark', `pillow__mark--${mark}`]} aria-hidden="true"></span>}
</section>

<style>
  .pillow {
    position: relative;
    display: flex;
    min-height: 62vh;
    padding: calc(var(--unit) * 10) var(--inset);
    background: var(--ground);
    overflow: hidden;
  }
  .pillow.paper { background: var(--paper); }

  .pillow--end { align-items: flex-end; justify-content: flex-start; }
  .pillow--start { align-items: flex-start; justify-content: flex-start; }

  .pillow__line {
    position: relative;
    z-index: 1;
    font-family: var(--serif);
    font-weight: var(--serif-weight);
    font-size: clamp(1.5rem, 3.4vw, 2.4rem);
    line-height: 1.35;
    max-width: 22ch;
    color: var(--ink-on-ground);
  }
  .pillow.paper .pillow__line { color: var(--ink-on-paper); }

  .pillow__mark {
    position: absolute;
    width: 10px;
    height: 10px;
    background: var(--accent);
  }
  .pillow__mark--br { right: var(--inset); bottom: var(--inset); }
  .pillow__mark--tr { right: var(--inset); top: var(--inset); }
  .pillow__mark--bl { left: var(--inset); bottom: var(--inset); }

  @media (max-width: 640px) {
    .pillow { min-height: 48vh; }
  }
</style>
