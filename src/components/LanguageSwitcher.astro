---
import { LANGS } from '../data/copy';
---

<div class="langs" role="group" aria-label="Language">
  {LANGS.map((l) => (
    <button class="lang-btn" data-lang={l.code} type="button" aria-pressed="false">{l.label}</button>
  ))}
</div>

<style>
  .langs {
    display: flex;
    gap: 2px;
    flex-shrink: 0;
  }
  .lang-btn {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    padding: 7px 9px;
    border: var(--hair) solid transparent;
    background: transparent;
    color: var(--mute-on-ground);
    cursor: pointer;
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .lang-btn:hover { color: var(--ink-on-ground); }
  .lang-btn.active {
    color: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 620px) {
    .lang-btn { padding: 6px 6px; font-size: 11px; }
  }
</style>
