---
import type { SkiArea } from '../data/types';

interface Props {
  area: SkiArea;
  accentColor: string;
}

const { area, accentColor } = Astro.props;
const transJson = JSON.stringify(area.translations ?? {});

const totalRuns = area.runs.reduce((s, r) => s + r.count, 0);
const totalLifts = area.lifts.reduce((s, l) => s + l.count, 0);

const difficultyColors: Record<string, string> = {
  green: '#2F7D32',
  blue: '#1565C0',
  red: '#C62828',
  black: '#212121',
};

const liftIcons: Record<string, string> = {
  gondola: '🚡',
  chairlift: '🪑',
  surface: '🎿',
  magic_carpet: '🟫',
};
---

<div class="ski-card" data-translations={transJson}>
  <div class="ski-card-header" style={`border-top-color: ${accentColor}`}>
    <div class="ski-card-title-row">
      <div>
        <h3 class="ski-card-name" data-field="name">{area.name}</h3>
        {area.name_ja && <p class="ski-card-name-ja">{area.name_ja}</p>}
      </div>
      {area.price_adult_day && (
        <span class="ski-card-price">{area.price_adult_day}<span class="ski-price-label">/day</span></span>
      )}
    </div>

    <div class="ski-card-stats">
      <div class="ski-stat">
        <span class="ski-stat-value">{area.vertical_m}m</span>
        <span class="ski-stat-label">Vertical</span>
      </div>
      <div class="ski-stat-divider"></div>
      <div class="ski-stat">
        <span class="ski-stat-value">{area.elevation_summit_m}m</span>
        <span class="ski-stat-label">Summit</span>
      </div>
      <div class="ski-stat-divider"></div>
      <div class="ski-stat">
        <span class="ski-stat-value">{totalRuns}</span>
        <span class="ski-stat-label">Runs</span>
      </div>
      <div class="ski-stat-divider"></div>
      <div class="ski-stat">
        <span class="ski-stat-value">{totalLifts}</span>
        <span class="ski-stat-label">Lifts</span>
      </div>
    </div>
  </div>

  <div class="ski-card-body">
    <!-- Difficulty breakdown -->
    <div class="piste-row">
      {area.runs.map(run => (
        <div class="piste-badge" style={`background: ${difficultyColors[run.difficulty]}18; border: 1px solid ${difficultyColors[run.difficulty]}44`}>
          <span class="piste-dot" style={`background: ${difficultyColors[run.difficulty]}`}></span>
          <span class="piste-count">{run.count}</span>
          <span class="piste-label">{run.difficulty}</span>
        </div>
      ))}
    </div>

    <!-- Lifts row -->
    <div class="lifts-row">
      {area.lifts.map(lift => (
        <span class="lift-badge">
          {liftIcons[lift.type]} {lift.count} {lift.type.replace('_', ' ')}
        </span>
      ))}
    </div>

    <p class="ski-card-description" data-field="description">{area.description}</p>

    <!-- Feature tags -->
    <div class="ski-feature-row">
      {area.night_skiing && <span class="feature-tag feature-night">Night skiing</span>}
      {area.snowmaking && <span class="feature-tag feature-snow">Snowmaking</span>}
      {area.terrain_park && <span class="feature-tag feature-park">Terrain park</span>}
      <span class="feature-tag feature-season">{area.season}</span>
    </div>

    {area.tip && (
      <div class="ski-tip">
        <span class="ski-tip-icon">💡</span>
        <p class="ski-tip-text" data-field="tip">{area.tip}</p>
      </div>
    )}

    <div class="ski-card-footer">
      {area.mapUrl && (
        <a href={area.mapUrl} target="_blank" rel="noopener" class="ski-link">
          View on map →
        </a>
      )}
      {area.website && (
        <a href={area.website} target="_blank" rel="noopener" class="ski-link ski-link-primary" style={`color: ${accentColor}`}>
          Resort website →
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .ski-card {
    background: white;
    border: 1px solid var(--cream-dark);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .ski-card:hover {
    box-shadow: 0 6px 28px rgba(0,0,0,0.09);
    transform: translateY(-2px);
  }

  .ski-card-header {
    border-top: 4px solid;
    padding: 1.5rem 1.5rem 1.25rem;
    background: var(--cream);
  }
  .ski-card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .ski-card-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--ink);
    line-height: 1.15;
  }
  .ski-card-name-ja {
    font-size: 0.8rem;
    color: var(--ink-faint);
    margin-top: 0.2rem;
  }
  .ski-card-price {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 300;
    color: var(--ink);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .ski-price-label {
    font-size: 0.7rem;
    color: var(--ink-faint);
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    margin-left: 0.1rem;
  }

  .ski-card-stats {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .ski-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    flex: 1;
  }
  .ski-stat-value {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 300;
    color: var(--ink);
    line-height: 1;
  }
  .ski-stat-label {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  .ski-stat-divider {
    width: 1px;
    height: 2rem;
    background: var(--cream-dark);
    flex-shrink: 0;
  }

  .ski-card-body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .piste-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .piste-badge {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: 20px;
    font-size: 0.78rem;
  }
  .piste-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .piste-count {
    font-weight: 600;
    color: var(--ink);
  }
  .piste-label {
    color: var(--ink-muted);
    text-transform: capitalize;
  }

  .lifts-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .lift-badge {
    font-size: 0.75rem;
    color: var(--ink-muted);
    background: var(--cream);
    border: 1px solid var(--cream-dark);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius);
    white-space: nowrap;
    text-transform: capitalize;
  }

  .ski-card-description {
    font-size: 0.875rem;
    color: var(--ink-muted);
    line-height: 1.7;
  }

  .ski-feature-row {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .feature-tag {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.25rem 0.6rem;
    border-radius: 20px;
    letter-spacing: 0.02em;
  }
  .feature-night { background: #1a1a2e; color: #a0aec0; }
  .feature-snow  { background: #ebf8ff; color: #2b6cb0; }
  .feature-park  { background: #f0fff4; color: #276749; }
  .feature-season { background: var(--cream); color: var(--ink-muted); border: 1px solid var(--cream-dark); }

  .ski-tip {
    display: flex;
    gap: 0.6rem;
    background: var(--cream);
    border-left: 3px solid var(--cream-dark);
    padding: 0.75rem 1rem;
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .ski-tip-icon { font-size: 0.9rem; flex-shrink: 0; line-height: 1.6; }
  .ski-tip-text { font-size: 0.825rem; color: var(--ink-muted); line-height: 1.65; margin: 0; }

  .ski-card-footer {
    display: flex;
    gap: 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--cream-dark);
    margin-top: auto;
  }
  .ski-link {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-faint);
  }
  .ski-link-primary { font-weight: 600; }
  .ski-link:hover { text-decoration: underline; }
</style>
