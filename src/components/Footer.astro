---
import { INSTAGRAM, HANDLE, BRAND } from '../data/copy';
---

<footer class="foot">
  <hr class="rule" />
  <div class="foot__row">
    <span class="foot__brand">{BRAND}</span>
    <span class="foot__note" data-i18n="footerNote">Tateshina · Chino · Nagano</span>
    <a class="foot__handle" href={INSTAGRAM} rel="noopener noreferrer" target="_blank">{HANDLE}</a>
  </div>
</footer>

<style>
  .foot {
    background: var(--ground);
    padding: 0 var(--inset) calc(var(--unit) * 6);
  }
  .foot__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: calc(var(--unit) * 2);
    padding-top: calc(var(--unit) * 4);
  }
  .foot__brand {
    font-family: var(--serif);
    font-weight: var(--serif-weight);
    font-size: 17px;
    color: var(--ink-on-ground);
  }
  .foot__note {
    font-size: 13px;
    color: var(--mute-on-ground);
  }
  .foot__handle {
    font-size: 14px;
    color: var(--accent);
    text-decoration: none;
  }
  .foot__handle:hover { text-decoration: underline; }
</style>
