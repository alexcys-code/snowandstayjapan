---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HotelCard from '../components/HotelCard.astro';
import RestaurantCard from '../components/RestaurantCard.astro';
import SkiAreaCard from '../components/SkiAreaCard.astro';
import MapSection from '../components/MapSection.astro';
import type { CityData } from '../data/types';

const { city } = Astro.props as { city: CityData };
const base = import.meta.env.BASE_URL;

const prev: Record<string, string|null> = { yatsugatake: null, tokyo: 'yatsugatake' };
const next: Record<string, string|null> = { yatsugatake: 'tokyo', tokyo: null };

function capitalize(s: string) { return s.charAt(0).toUpperCase() + s.slice(1); }

const skiAreas = city.skiAreas ?? [];
const totalRuns = skiAreas.reduce((sum, a) =>
  sum + a.runs.reduce((s, r) => s + r.count, 0), 0);
const totalLifts = skiAreas.reduce((sum, a) =>
  sum + a.lifts.reduce((s, l) => s + l.count, 0), 0);
const maxVertical = skiAreas.length ? Math.max(...skiAreas.map(a => a.vertical_m)) : 0;
---

<Layout title={city.name} description={`Winter sports guide to ${city.name}, Japan — ski areas, resorts, accommodation and dining`}>
  <header>
    <Nav active={city.slug} />
  </header>

  <header class="city-hero" style={`--city-accent: ${city.accentColor}`}>
    <div class="city-hero-inner">
      <p class="city-eyebrow">{city.season ?? city.dates} · {skiAreas.length ? `${skiAreas.length} ski areas` : `${city.nights} nights`}</p>
      <h1 class="city-title">{city.name}</h1>
      <p class="city-tagline">{city.tagline}</p>
    </div>
    <div class="city-hero-accent-bar" style={`background: ${city.accentColor}`}></div>
  </header>

  <!-- Quick stats bar (ski destinations only) -->
  {skiAreas.length > 0 && <div class="stats-bar">
    <div class="stats-inner">
      <div class="stat">
        <span class="stat-value">{city.skiAreas.length}</span>
        <span class="stat-label">Ski areas</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">{totalRuns}</span>
        <span class="stat-label">Total runs</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">{totalLifts}</span>
        <span class="stat-label">Total lifts</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">{maxVertical}m</span>
        <span class="stat-label">Best vertical</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">{city.season}</span>
        <span class="stat-label">Season</span>
      </div>
    </div>
  </div>}

  <main>
    <!-- Map -->
    <section class="section">
      <div class="container">
        <div class="section-label">OVERVIEW</div>
        <h2 class="section-title">{city.name} at a glance</h2>
        <p class="section-intro">Ski areas, hotels and restaurants — all on one map.</p>
        <MapSection
          mapCenter={city.mapCenter}
          mapZoom={city.mapZoom}
          mapPoints={city.mapPoints}
          accentColor={city.accentColor}
        />
      </div>
    </section>

    <!-- Ski Areas -->
    {skiAreas.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-label">SKI AREAS</div>
        <h2 class="section-title">On the mountain</h2>
        <p class="section-intro">Three ski areas within an hour of Kobuchizawa, from beginner-friendly plateaus to Japan's longest Highland vertical.</p>
        <div class="ski-grid">
          {skiAreas.map(area => (
            <SkiAreaCard area={area} accentColor={city.accentColor} />
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- Getting there -->
    {city.transport && (
      <section class="section transport-section">
        <div class="container">
          <div class="section-label">GETTING THERE</div>
          <h2 class="section-title">How to reach {city.name}</h2>
          <div class="transport-bar" style={`border-left-color: ${city.accentColor}; background: ${city.accentColor}0D`}>
            <span class="transport-icon">🚄</span>
            <p class="transport-text">{city.transport}</p>
          </div>
        </div>
      </section>
    )}

    <!-- Hotels -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-label">WHERE TO STAY</div>
        <h2 class="section-title">Ski lodges & resorts</h2>
        <p class="section-intro">From luxury onsen resorts with ski shuttles to value pensions with heated boot rooms.</p>
        <div class="cards-grid">
          {city.hotels.map(h => (
            <HotelCard hotel={h} translations={h.translations ?? {}} />
          ))}
        </div>
      </div>
    </section>

    <!-- Restaurants -->
    <section class="section">
      <div class="container">
        <div class="section-label">WHERE TO EAT</div>
        <h2 class="section-title">Après-ski & dining</h2>
        <p class="section-intro">Post-slope soba, log-cabin dinners and farm kitchens — the best eating in the Yatsugatake Highlands.</p>
        <div class="cards-grid">
          {city.restaurants.map(r => (
            <RestaurantCard restaurant={r} translations={r.translations ?? {}} />
          ))}
        </div>
      </div>
    </section>

    <section class="section city-nav-section">
      <div class="container">
        <div class="city-nav">
          {prev[city.slug] ? (
            <a href={`${base}${prev[city.slug]}/`} class="city-nav-btn city-nav-prev">
              ← {capitalize(prev[city.slug]!)}
            </a>
          ) : (
            <a href={base} class="city-nav-btn city-nav-prev">← Overview</a>
          )}
          {next[city.slug] ? (
            <a href={`${base}${next[city.slug]}/`} class="city-nav-btn city-nav-next">
              {capitalize(next[city.slug]!)} →
            </a>
          ) : (
            <a href={base} class="city-nav-btn city-nav-next">Back to Overview →</a>
          )}
        </div>
      </div>
    </section>
  </main>

  <Footer footerText="⛷ Yatsugatake Winter Sports" repoUrl="https://github.com/yourusername/yatsugatake-ski" />
</Layout>

<style>
  .city-hero {
    padding: 5rem 2rem 4rem;
    text-align: center;
    border-bottom: 1px solid var(--cream-dark);
    position: relative;
    background: radial-gradient(ellipse 60% 50% at 50% 60%, rgba(0,0,0,0.03), transparent);
  }
  .city-hero-inner { max-width: 700px; margin: 0 auto; }
  .city-eyebrow {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--city-accent);
    margin-bottom: 1rem;
  }
  .city-title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 300;
    color: var(--ink);
    line-height: 0.9;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }
  .city-tagline {
    font-size: 1.05rem;
    color: var(--ink-muted);
    font-weight: 300;
    line-height: 1.6;
  }
  .city-hero-accent-bar {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 3px;
    border-radius: 2px;
  }

  /* Stats bar */
  .stats-bar {
    background: white;
    border-bottom: 1px solid var(--cream-dark);
    padding: 1.25rem 2rem;
  }
  .stats-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0 2rem;
  }
  .stat-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--ink);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.65rem;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .stat-divider {
    width: 1px;
    height: 2.5rem;
    background: var(--cream-dark);
    flex-shrink: 0;
  }

  .section { padding: 5rem 2rem; }
  .section-alt { background: white; }
  .container { max-width: 1100px; margin: 0 auto; }
  .section-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pt-green);
    margin-bottom: 0.75rem;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 300;
    color: var(--ink);
    margin-bottom: 1rem;
  }
  .section-intro {
    font-size: 1rem;
    color: var(--ink-muted);
    max-width: 600px;
    margin-bottom: 2.5rem;
    line-height: 1.75;
  }

  .ski-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.25rem;
  }

  .transport-section { background: var(--cream); }
  .transport-bar {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid;
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: 700px;
  }
  .transport-icon { font-size: 1.1rem; flex-shrink: 0; }
  .transport-text { font-size: 0.875rem; color: var(--ink-muted); line-height: 1.7; }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .city-nav-section { padding: 3rem 2rem; background: white; border-top: 1px solid var(--cream-dark); }
  .city-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .city-nav-btn {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--ink-muted);
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--cream-dark);
    border-radius: var(--radius);
    background: var(--cream);
    transition: background 0.2s, color 0.2s;
  }
  .city-nav-btn:hover { background: var(--cream-dark); color: var(--ink); }

  @media (max-width: 600px) {
    .city-hero { padding: 4rem 1.5rem 3rem; }
    .section { padding: 3rem 1.25rem; }
    .ski-grid, .cards-grid { grid-template-columns: 1fr; }
    .city-nav { flex-direction: column; }
    .city-nav-btn { width: 100%; text-align: center; }
    .stats-inner { flex-wrap: wrap; gap: 1rem; }
    .stat-divider { display: none; }
    .stat { padding: 0 1rem; }
  }
</style>
