---
import type { Day, DayTranslations } from '../data/types';
interface Props {
  day: Day;
  accentColor: string;
  translations?: DayTranslations;
}
const { day, accentColor, translations = {} } = Astro.props;
const transJson = JSON.stringify(translations);
---

<div class="day-card" style={`--accent: ${accentColor}`} data-translations={transJson}>
  <div class="day-header">
    <span class="day-num">Day {day.dayNum}</span>
    <span class="day-date">{day.date}</span>
  </div>
  <h3 class="day-title" data-field="title">{day.title}</h3>
  <ul class="day-activities">
    {day.activities.map((a, i) => (
      <li class="activity">
        <span class="activity-dot"></span>
        <span class="activity-desc" data-field={`activity-${i}`}>{a.description}</span>
        <span class="activity-links">
          {a.url && <a href={a.url} target="_blank" rel="noopener" class="activity-link" title="Website">↗</a>}
          {a.mapUrl && <a href={a.mapUrl} target="_blank" rel="noopener" class="activity-map">Map</a>}
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  .day-card {
    background: white;
    border: 1px solid var(--cream-dark);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: box-shadow 0.2s;
  }
  .day-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.07); }
  .day-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .day-num {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .day-date {
    font-size: 0.68rem;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .day-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }
  .day-activities {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .activity {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--ink-muted);
    line-height: 1.5;
  }
  .activity-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    margin-top: 0.45em;
  }
  .activity-desc { flex: 1; }
  .activity-links {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
    margin-top: 0.1em;
  }
  .activity-link, .activity-map {
    font-size: 0.72rem;
    color: var(--accent);
    transition: opacity 0.15s;
    white-space: nowrap;
  }
  .activity-link:hover, .activity-map:hover { opacity: 0.6; }
</style>
