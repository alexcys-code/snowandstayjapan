---
import type { Restaurant, RestaurantTranslations } from '../data/types';

interface Props {
  restaurant: Restaurant;
  translations?: RestaurantTranslations;
}
const { restaurant, translations = {} } = Astro.props as Props;

const priceColors: Record<string, string> = {
  '¥': 'var(--green)',
  '¥¥': 'var(--gold)',
  '¥¥¥': 'var(--terra)',
};
const priceBg: Record<string, string> = {
  '¥': 'var(--green-light)',
  '¥¥': 'var(--gold-light)',
  '¥¥¥': 'var(--terra-light)',
};
const transJson = JSON.stringify(translations);
---

<div class="restaurant-card" data-translations={transJson}>
  <div class="card-top">
    <h3 class="card-name" data-field="name">{restaurant.name}</h3>
    <div class="rating">
      <span class="rating-star">★</span>
      <span class="rating-score">{restaurant.rating}</span>
      <span class="rating-count">({restaurant.ratingCount})</span>
    </div>
  </div>

  <div class="tags">
    <span class="tag price-tag" style={`color:${priceColors[restaurant.price] ?? 'var(--gold)'};background:${priceBg[restaurant.price] ?? 'var(--gold-light)'}`}>
      {restaurant.price}
    </span>
    {restaurant.bookAhead && <span class="tag book-tag" data-i18n="bookAhead">Book ahead</span>}
    {restaurant.tags.map(t => <span class="tag" data-field="tag">{t}</span>)}
  </div>

  <p class="card-desc" data-field="description">{restaurant.description}</p>

  <div class="card-footer">
    <p class="card-musttry">
      <span class="musttry-label" data-i18n="mustTry">Must try</span>
      <span data-field="mustTry">{restaurant.mustTry}</span>
    </p>
    {restaurant.hours && <p class="card-hours" data-field="hours">{restaurant.hours}</p>}
  </div>
</div>

<style>
  .restaurant-card {
    background: white;
    border: 1px solid var(--cream-dark);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .restaurant-card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    transform: translateY(-2px);
  }
  .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; }
  .card-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }
  .rating { display: flex; align-items: center; gap: 0.25rem; flex-shrink: 0; }
  .rating-star { color: var(--pt-yellow); font-size: 0.85rem; }
  .rating-score { font-size: 0.85rem; font-weight: 500; }
  .rating-count { font-size: 0.75rem; color: var(--ink-faint); }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tag {
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    background: var(--cream-dark);
    color: var(--ink-muted);
  }
  .price-tag { font-weight: 500; }
  .book-tag { background: var(--terra-light); color: var(--terra); font-weight: 500; }
  .card-desc { font-size: 0.875rem; color: var(--ink-muted); line-height: 1.65; }
  .card-footer {
    padding-top: 0.5rem;
    border-top: 1px solid var(--cream-dark);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .card-musttry { font-size: 0.82rem; color: var(--ink-muted); font-style: italic; }
  .musttry-label {
    font-style: normal;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-right: 0.35rem;
  }
  .card-hours { font-size: 0.78rem; color: var(--ink-faint); }
</style>
